    {
      "doc": "attention",
      "type": "answer",
      "q": "Why do they scale the dot products by the square root of d_k?",
      "expect": [
        "gradient|large|softmax"
      ],
      "pages": [
        "Page 4"
      ],
      "route": "document_question",
      "error": null,
      "refused": false,
      "route_ok": true,
      "correct": true,
      "hit_at_5": true,
      "citation_precision": 1.0,
      "mode": "hybrid",
      "answer": "They scale the dot products by \\(1/\\sqrt{d_k}\\) because, without this factor, the dot products become large in magnitude as the dimensionality \\(d_k\\) grows, which pushes the softmax into regions with extremely small gradients. The scaling counteracts this effect and keeps the softmax\u2019s gradients well\u2011behaved[1].",
      "route_got": "document_question",
      "latency": 0.51,
      "evidence_locations": [
        "Page 4",
        "Page 4",
        "Page 4",
        "Page 7",
        "Page 4"
