    {
      "doc": "attention",
      "type": "answer",
      "q": "Why did they choose sinusoidal positional encodings?",
      "expect": [
        "extrapolat|longer|relative position"
      ],
      "pages": [
        "Page 6"
      ],
      "route": "document_question",
      "error": null,
      "refused": false,
      "route_ok": true,
      "correct": true,
      "hit_at_5": true,
      "citation_precision": 1.0,
      "mode": "dense",
      "answer": "They selected sinusoidal positional encodings because the sinusoid functions produce a geometric progression of wavelengths that makes it easy for the model to learn relative positions\u2014any fixed offset can be expressed as a linear function of the encodings. This property was hypothesized to help the model attend by relative positions, and it also allows potential extrapolation to longer sequences than seen during training[2]. Additionally, experiments showed that learned positional embeddings gave nearly the same results, so the sinusoidal version was preferred for its theoretical advantages[2].",
      "route_got": "document_question",
      "latency": 6.85,
