    {
      "doc": "attention",
      "type": "answer",
      "q": "Why do they scale the dot products by the square root of d_k?",
      "expect": [
        "gradient|large|softmax"
      ],
      "pages": [
        "Page 4"
      ],
      "route": "document_question",
      "error": null,
      "refused": false,
      "route_ok": true,
      "correct": true,
      "hit_at_5": true,
      "citation_precision": 1.0,
      "mode": "hybrid",
      "answer": "They scale the dot products by \\(1/\\sqrt{d_k}\\) because, as the dimensionality \\(d_k\\) grows, the raw dot products become large in magnitude. This pushes the soft\u2011max into regions where its gradients are extremely small, making learning difficult. Dividing by \\(\\sqrt{d_k}\\) counteracts this effect and keeps the soft\u2011max\u2019s gradients well\u2011behaved[4].",
      "route_got": "document_question",
      "latency": 1.28,
      "evidence_locations": [
        "Page 4",
        "Page 4",
        "Page 4",
        "Page 4",
        "Page 7"
      ]
    },
    {
      "doc": "attention",
      "type": "answer",
      "q": "Why did they choose sinusoidal positional encodings?",
      "expect": [
        "extrapolat|longer|relative position"
      ],
      "pages": [
