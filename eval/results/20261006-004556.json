    {
      "doc": "attention",
      "type": "answer",
      "q": "Why do they scale the dot products by the square root of d_k?",
      "expect": [
        "gradient|large|softmax"
      ],
      "pages": [
        "Page 4"
      ],
      "route": "document_question",
      "error": null,
      "refused": false,
      "route_ok": true,
      "correct": true,
      "hit_at_5": true,
      "citation_precision": 1.0,
      "mode": "hybrid",
      "answer": "They scale the dot products by \\(1/\\sqrt{d_k}\\) because, as the dimensionality \\(d_k\\) grows, the raw dot products become large in magnitude, which pushes the soft\u2011max into regions with extremely small gradients. Dividing by \\(\\sqrt{d_k}\\) keeps the values in a range where the soft\u2011max remains well\u2011behaved and gradients stay useful[4]. This scaling factor (\\(1/\\sqrt{d_k}\\)) is the specific term used in their \u201cScaled Dot\u2011Product Attention\u201d formulation[1].",
      "route_got": "document_question",
      "latency": 1.09,
      "evidence_locations": [
        "Page 4",
        "Page 4",
        "Page 4",
        "Page 4",
        "Page 7"
      ]
    },
    {
      "doc": "attention",
      "type": "answer",
      "q": "Why did they choose sinusoidal positional encodings?",
      "expect": [
        "extrapolat|longer|relative position"
      ],
      "pages": [
